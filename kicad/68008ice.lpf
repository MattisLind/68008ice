# MC68008 ICE - schematic pin allocation (2026-11-07)
# Proposed RTL port names match schematic global signal nets.
# Outer ring = 0; use successive rings only when outer legal pins are exhausted.
# All general banks use 3.3 V LVCMOS. Power and dedicated JTAG/CFG pins are not LOCATE ports.
# Boot: single-SPI; reclaim unused configuration ports for bank-8 D2..D7.
# CCLK N9 is driven through USRMCLK, not a fabric GPIO.

# PL26A, bank 6, escape ring 0
LOCATE COMP "BUS_ENABLE_3V3" SITE "L1";
IOBUF PORT "BUS_ENABLE_3V3" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
# PL20A, bank 7, escape ring 0
LOCATE COMP "CLK_50M" SITE "G1";
IOBUF PORT "CLK_50M" IO_TYPE=LVCMOS33 PULLMODE=NONE;
# PL26C, bank 6, escape ring 0
LOCATE COMP "CPU_CLOCK_OE_N" SITE "M1";
IOBUF PORT "CPU_CLOCK_OE_N" IO_TYPE=LVCMOS33 PULLMODE=UP;
# PL32A, bank 6, escape ring 0
LOCATE COMP "CPU_DATA_OE_N" SITE "N1";
IOBUF PORT "CPU_DATA_OE_N" IO_TYPE=LVCMOS33 PULLMODE=UP;
